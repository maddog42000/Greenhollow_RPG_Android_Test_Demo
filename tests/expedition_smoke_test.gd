extends SceneTree

func _initialize():
 call_deferred("_run")

func _run():
 var game=load("res://scenes/main.tscn").instantiate()
 root.add_child(game)
 await process_frame
 game.call("_start")
 game.call("_change_area","forest",Vector2(65,380))
 assert(bool(game.get("expedition_active")),"Leaving the village should begin an expedition")
 assert(int(game.get("expedition_depth"))==0,"First room begins at depth zero")
 assert(is_equal_approx(float(game.call("_homeward_chance")),0.20),"Base homeward chance should be 20 percent")
 game.call("_change_area","village",Vector2(640,380),0.99)
 assert(bool(game.get("expedition_active")),"A missed homeward roll should continue the expedition")
 assert(game.get("area_id")!="village","A missed roll must not route directly home")
 assert(int(game.get("expedition_depth"))==1,"A missed roll should deepen the run")
 game.set("expedition_loot",{"gold":25,"Forest Herb":1,"Rough Ore":0,"Oak Wood":0})
 game.call("_spawn","slime",game.get("hero")+Vector2(40,0))
 var blocked_area:String=str(game.get("area_id"))
 game.call("_change_area","village",Vector2(640,380),0.0)
 assert(str(game.get("area_id"))==blocked_area,"Hostiles must block room exits")
 game.get("enemies").clear()
 game.get("wave_director").set("phase","checkpoint")
 var gold_before:int=int(game.get("gold"))
 game.call("_change_area","village",Vector2(640,380),0.0)
 assert(not bool(game.get("expedition_active")),"A successful homeward roll should end the run")
 assert(str(game.get("area_id"))=="village","Successful homeward roll should return to Greenhollow")
 assert(int(game.get("gold"))==gold_before+25,"Returned expedition gold should be banked")
 assert(int(game.get("inventory")["Forest Herb"])==1,"Returned expedition supplies should be banked")

 game.set("screen","shop")
 game.set("inventory",{"Small Health Potion":2,"Forest Herb":2,"Rough Ore":4,"Oak Wood":4})
 game.set("gold",12)
 game.call("_tap",Vector2(640,379))
 assert(int(game.get("inventory")["Small Health Potion"])==3,"Workshop should craft a potion from herbs/wood")
 assert(int(game.get("inventory")["Forest Herb"])==0 and int(game.get("inventory")["Oak Wood"])==3,"Potion recipe should consume ingredients")
 game.call("_tap",Vector2(640,469))
 assert(bool(game.get("waystone_built")),"Workshop should build the Waystone")
 assert(int(game.get("inventory")["Rough Ore"])==0 and int(game.get("inventory")["Oak Wood"])==0,"Waystone should consume ore and wood")
 assert(is_equal_approx(float(game.call("_homeward_chance")),0.28),"Waystone should add eight percentage points to the homeward chance")
 game.call("_tap",Vector2(640,289))
 assert(int(game.get("inventory")["Small Health Potion"])==4,"Workshop should sell health potions for gold")
 assert(int(game.get("gold"))==0,"Buying a potion should deduct its price")

 var bank_gold:int=int(game.get("gold"))
 game.set("area_id","forest")
 game.call("_begin_expedition")
 game.get("wave_director").set("phase","checkpoint")
 game.set("expedition_depth",7)
 game.set("expedition_loot",{"gold":23,"Forest Herb":2,"Rough Ore":1,"Oak Wood":0})
 var loss_message:String=str(game.call("_lose_expedition"))
 assert(not bool(game.get("expedition_active")),"Death should end the run")
 assert(int(game.get("gold"))==bank_gold,"Death must not bank unreturned expedition gold")
 assert(int(game.get("inventory")["Forest Herb"])==0,"Death must lose unbanked supplies")
 assert(loss_message.contains("lost unbanked 23G"),"Death summary should describe the lost haul")

 game.set("area_id","forest")
 game.call("_begin_expedition")
 game.set("expedition_depth",7)
 game.set("expedition_loot",{"gold":11,"Forest Herb":1,"Rough Ore":2,"Oak Wood":3})
 game.set("waystone_built",true)
 var saved_attacks:Array[String]=["Whirlwind"]
 game.set("attack_slots",saved_attacks)
 game.set("attack_ranks",{"Whirlwind":2})
 game.set("screen","game")
 game.call("_save")
 game.set("expedition_active",false)
 game.set("attack_slots",[])
 game.set("waystone_built",false)
 game.call("_load")
 assert(bool(game.get("expedition_active")) and int(game.get("expedition_depth"))==8,"Save/load should safely resume at the next checkpoint")
 assert(int(game.get("expedition_loot")["gold"])==11,"Save/load should preserve unbanked haul")
 assert(bool(game.get("waystone_built")),"Save/load should preserve the home Waystone")
 assert(game.get("attack_slots")==["Whirlwind"] and int(game.get("attack_ranks")["Whirlwind"])==2,"Save/load should preserve active attack slots and ranks")
 print("EXPEDITION_CRAFTING_SAVE_TEST=PASS")
 quit()
