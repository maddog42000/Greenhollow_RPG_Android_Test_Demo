extends SceneTree

func _initialize():
 call_deferred("_run")

func _run():
 var game=load("res://scenes/main.tscn").instantiate()
 root.add_child(game)
 await process_frame
 game.call("_start")
 game.set("screen","game")
 game.set("hero",Vector2(640,380))
 game.set("xp",0)
 game.set("xp_next",50)
 game.call("_register_enemy_kill",{"pos":Vector2(740,380),"xp":50})
 assert(int(game.get("xp"))==0,"Enemy defeat should drop a shard instead of granting XP directly")
 assert(game.get("xp_pickups").size()==1,"Enemy defeat should create one collectible XP gem")
 assert(int(game.get("xp_pickups")[0]["xp"])==50,"Shard should hold the enemy's XP reward")
 var position_before:Vector2=game.get("xp_pickups")[0]["pos"]
 game.call("_update_xp_pickups",0.1)
 var position_after:Vector2=game.get("xp_pickups")[0]["pos"]
 assert(position_after.distance_to(game.get("hero"))<position_before.distance_to(game.get("hero")),"Nearby XP shard should magnet toward the player")
 game.set("hero",position_after)
 game.call("_update_xp_pickups",0.016)
 assert(game.get("xp_pickups").is_empty(),"Walking over an XP shard should collect it")
 assert(int(game.get("level"))==2 and game.get("screen")=="level_up","Collecting enough XP should pause for the level-up choice")
 assert(int(game.get("xp"))==0,"Collected XP should roll into the next level bar")
 assert(game.get("levelup_options").size()==3,"Each level should present three random picks")
 var key_event:=InputEventKey.new()
 key_event.keycode=KEY_1
 key_event.pressed=true
 var catalog=load("res://scripts/upgrade_catalog.gd").new()
 var ability_options:Array[Dictionary]=[catalog.get_card("warrior_whirlwind")]
 game.set("levelup_options",ability_options)
 game.call("_input",key_event)
 assert(game.get("screen")=="game" and game.get("attack_slots")==["Whirlwind"],"Selecting a class ability should equip it and resume play")

 game.call("_register_enemy_kill",{"pos":Vector2(640,380),"xp":180})
 assert(game.get("xp_pickups").size()==1 and int(game.get("xp"))==0,"Large enemy reward should still require gem collection")
 game.set("hero",game.get("xp_pickups")[0]["pos"])
 game.call("_update_xp_pickups",0.016)
 assert(int(game.get("level"))==4 and int(game.get("pending_levelup_count"))==2,"A large shard should queue one pick for each gained level")
 assert(game.get("screen")=="level_up","Queued levels must pause until each pick is made")
 game.call("_input",key_event)
 assert(game.get("screen")=="level_up" and int(game.get("pending_levelup_count"))==1,"First choice should advance to the next queued pick")
 game.call("_input",key_event)
 assert(game.get("screen")=="game" and int(game.get("pending_levelup_count"))==0,"Second choice should resume the expedition")

 game.call("_change_area","forest",Vector2(640,380))
 game.get("wave_director").set("phase","checkpoint")
 game.get("xp_pickups").append({"pos":Vector2(900,500),"xp":7,"phase":0.0})
 game.call("_change_area","village",Vector2(640,380),0.99)
 assert(int(game.get("best_depth"))==1,"A deeper room should update the personal best")
 assert(game.get("xp_pickups").is_empty(),"Uncollected shards should be left behind when leaving a room")
 assert(str(game.get("notice")).contains("7 uncollected XP"),"Room transition should warn about lost uncollected XP")
 var xp_before_death:int=int(game.get("xp"))
 game.get("xp_pickups").append({"pos":Vector2(900,500),"xp":5,"phase":0.0})
 var death_message:String=game.call("_lose_expedition")
 assert(int(game.get("runs_lost"))==1,"Failed expedition should increment the falls counter")
 assert(death_message.contains("5 uncollected XP"),"Failed run should report uncollected XP loss")
 assert(int(game.get("xp"))==xp_before_death,"Collected character XP should persist after a run ends")

 game.set("area_id","village")
 game.call("_change_area","forest",Vector2(640,380))
 var saved_pickups:Array[Dictionary]=game.get("xp_pickups")
 saved_pickups.append({"pos":Vector2(820,410),"xp":17,"phase":1.2})
 game.set("xp_pickups",saved_pickups)
 game.set("best_depth",4)
 game.set("runs_completed",2)
 game.set("screen","game")
 game.call("_save")
 game.get("xp_pickups").clear()
 game.set("best_depth",0)
 game.set("runs_completed",0)
 game.call("_load")
 assert(int(game.get("best_depth"))==4 and int(game.get("runs_completed"))==2,"Save/load should retain retry and best-depth records")
 assert(game.get("xp_pickups").size()==1 and int(game.get("xp_pickups")[0]["xp"])==17,"Save/load should retain uncollected XP shards")
 assert(game.get("xp_pickups")[0]["pos"]==Vector2(820,410),"Save/load should retain shard positions")
 print("PROGRESSION_XP_PICKUP_TEST=PASS")
 quit()
